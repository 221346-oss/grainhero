# Environment variables — keep root .env tracked for shared public app config,
# but continue ignoring local/secret environment variants.
.env.local
.env.*.local
.env.example


# Build info
*.tsbuildinfo

# Secrets — never commit service accounts or credential files
*service-account*.json
*firebase-adminsdk*.json
*.pem
*.key

# Markdown files — notes, session records and internal docs stay local.
# Already-tracked .md files (README.md, docs/**, AGENTS.md) keep tracking;
# use `git add -f` if a specific new doc should ever be committed.
*.md
.freebuff
desktop-v2.db
desktop-v2.db-shm
desktop-v2.db-wal
project-id
