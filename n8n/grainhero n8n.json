        "html": "=<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;background:#f9f9f9;padding:20px\">\n  <div style=\"background:#1a1a2e;color:white;padding:20px;border-radius:8px 8px 0 0\">\n    <h2 style=\"margin:0\">🌾 GrainHero Alert</h2>\n  </div>\n  <div style=\"background:white;padding:20px;border:1px solid #ddd\">\n    <table style=\"width:100%;border-collapse:collapse\">\n      <tr><td style=\"padding:8px;color:#666\">Silo</td><td style=\"padding:8px;font-weight:bold\">{{ $('Code in JavaScript1').item.json.siloId }}</td></tr>\n      <tr style=\"background:#f5f5f5\"><td style=\"padding:8px;color:#666\">Alert</td><td style=\"padding:8px;font-weight:bold\">{{ $('Code in JavaScript1').item.json.title }}</td></tr>\n      <tr><td style=\"padding:8px;color:#666\">Reading</td><td style=\"padding:8px;font-weight:bold;color:#e74c3c\">{{ $('Code in JavaScript1').item.json.metricValue }} (threshold: {{ $('Code in JavaScript1').item.json.threshold }})</td></tr>\n      <tr style=\"background:#f5f5f5\"><td style=\"padding:8px;color:#666\">Priority</td><td style=\"padding:8px;font-weight:bold;color:#e74c3c\">{{ $('Code in JavaScript1').item.json.priority.toUpperCase() }}</td></tr>\n      <tr><td style=\"padding:8px;color:#666\">Time</td><td style=\"padding:8px\">{{ $('Code in JavaScript1').item.json.triggeredAt }}</td></tr>\n    </table>\n    <div style=\"margin-top:20px;padding:15px;background:#fff3cd;border-left:4px solid #f39c12;border-radius:4px\">\n      <h3 style=\"margin:0 0 10px 0;color:#856404\">🤖 AI Recommendation</h3>\n      <p style=\"margin:0;color:#533f03\">{{ $('HTTP Request').item.json.answer || 'Check sensor readings manually and consult operational manual.' }}</p>\n    </div>\n  </div>\n  <div style=\"background:#f0f0f0;padding:10px;text-align:center;border-radius:0 0 8px 8px;font-size:12px;color:#666\">\n    GrainHero, Intelligent Grain Storage Management\n  </div>\n</div>\n",
