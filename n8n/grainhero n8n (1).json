      "parameters": {
        "jsCode": "// Get the raw webhook payload from Supabase\nconst body = $('Webhook').item.json.body;\nconst record = body.record || body;\n\n// Pull out all the fields we need\nconst alertId     = record.alert_id    || record.id || 'unknown';\nconst adminId     = record.admin_id    || '';\nconst siloId      = record.silo_id     || 'Unknown Silo';\nconst warehouseId = record.warehouse_id || null;\nconst title       = record.title       || 'Grain Alert';\nconst message     = record.message     || '';\nconst priority    = record.priority    || 'medium';\nconst sensorType  = record.sensor_type || '';\nconst triggerCond = record.trigger_conditions || {};\n\n// Get the actual sensor reading and threshold from trigger_conditions\nconst metricValue = triggerCond.value     || null;\nconst threshold   = triggerCond.threshold || null;\nconst metric      = triggerCond.metric    || sensorType;\n\n// Map priority to severity label\nconst severityMap = { critical:'critical', high:'high', medium:'medium', low:'low' };\nconst severity = severityMap[priority] || 'medium';\n\n// Build a human-readable summary line\nconst summary = (metricValue !== null && threshold !== null)\n  ? `${title}: ${metric} reading ${metricValue} exceeded threshold ${threshold}`\n  : message;\n\n// Return clean object — all future nodes use these variables\nreturn [{ json: {\n  alertId,\n  adminId,\n  siloId,\n  warehouseId,\n  title,\n  message,\n  summary,\n  priority,\n  severity,\n  sensorType,\n  metric,\n  metricValue,\n  threshold,\n  triggeredAt: new Date().toISOString(),\n}}];\n"
      },
