# ============================================================
# GrainHero n8n — Environment Variables
# ============================================================
# Copy this file to n8n/.env and fill in your real values.
# NEVER commit the real .env file to git.
#
# cp .env.example .env
# ============================================================


# ── n8n UI login credentials ──────────────────────────────────
# You use these to log into the n8n dashboard at localhost:5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_use_strong_password

# ── n8n encryption key ────────────────────────────────────────
# Encrypts all credentials stored in n8n (Supabase keys, Resend keys, etc.)
# Generate a random one: openssl rand -hex 32
# IMPORTANT: if you change this, all saved credentials are lost
N8N_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32


# ── Webhook secret ────────────────────────────────────────────
# Supabase sends this in the x-webhook-secret header with every webhook call.
# n8n checks it and rejects requests that don't match (security).
# Use any random string, e.g.: openssl rand -hex 20
N8N_WEBHOOK_SECRET=generate_random_secret_here


# ── Supabase ──────────────────────────────────────────────────
# n8n uses these to read/write the notifications table and grain_alerts table
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ── GrainHero RAG API ─────────────────────────────────────────
# URL of your deployed Python RAG server on Render
# n8n calls this to get AI recommendations for each alert
RAG_API_URL=https://your-ml-server.onrender.com/api/ai/query


# ── Resend (email) ────────────────────────────────────────────
# Already in your project — copy from your .env.local
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=alerts@yourdomain.com


# ── MoceanAPI (SMS) ───────────────────────────────────────────
# Sign up free at: https://moceanapi.com/register
# No credit card needed — free trial credits included
MOCEAN_API_KEY=your_mocean_api_key
MOCEAN_API_SECRET=your_mocean_api_secret
MOCEAN_FROM=GrainHero
